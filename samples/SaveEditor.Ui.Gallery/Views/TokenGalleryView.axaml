<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SaveEditor.Ui.Gallery.Views.TokenGalleryView"
             Background="{DynamicResource WindowBackground}"
             FontFamily="{DynamicResource FontFamilyDefault}">

  <!--
    Every colour here comes from a semantic resource. A resource-resolution test
    fails the build if this file names anything outside the semantic set, which is
    what keeps raw palette names internal.
  -->

  <UserControl.Styles>
    <Style Selector="TextBlock.heading">
      <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,18,0,8" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="Foreground" Value="{DynamicResource SubtleForeground}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style Selector="Border.swatch">
      <Setter Property="Width" Value="132" />
      <Setter Property="Height" Value="56" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBackground}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="28" Spacing="4">

      <TextBlock Text="Semantic tokens"
                 Foreground="{DynamicResource Foreground}"
                 FontSize="26" FontWeight="Bold" />
      <TextBlock Classes="caption"
                 Text="Generated from the pinned Catppuccin palette. Accent-dependent roles change with the selected accent." />

      <TextBlock Classes="heading" Text="Surfaces" />
      <WrapPanel Orientation="Horizontal">
        <StackPanel Margin="0,0,12,12">
          <Border Classes="swatch" Background="{DynamicResource WindowBackground}" />
          <TextBlock Classes="caption" Text="WindowBackground" />
        </StackPanel>
        <StackPanel Margin="0,0,12,12">
          <Border Classes="swatch" Background="{DynamicResource PanelBackground}" />
          <TextBlock Classes="caption" Text="PanelBackground" />
        </StackPanel>
        <StackPanel Margin="0,0,12,12">
          <Border Classes="swatch" Background="{DynamicResource CardBackground}" />
          <TextBlock Classes="caption" Text="CardBackground" />
        </StackPanel>
        <StackPanel Margin="0,0,12,12">
          <Border Classes="swatch" Background="{DynamicResource InputBackground}" />
          <TextBlock Classes="caption" Text="InputBackground" />
        </StackPanel>
        <StackPanel Margin="0,0,12,12">
          <Border Classes="swatch" Background="{DynamicResource OverlayBackground}" />
          <TextBlock Classes="caption" Text="OverlayBackground" />
        </StackPanel>
      </WrapPanel>

      <TextBlock Classes="heading" Text="Text on every surface" />
      <WrapPanel Orientation="Horizontal">
        <Border Classes="card" Background="{DynamicResource WindowBackground}" Margin="0,0,12,12">
          <StackPanel Spacing="4">
            <TextBlock Text="Foreground" Foreground="{DynamicResource Foreground}" />
            <TextBlock Text="MutedForeground" Foreground="{DynamicResource MutedForeground}" />
            <TextBlock Text="SubtleForeground" Foreground="{DynamicResource SubtleForeground}" />
            <TextBlock Text="PrimaryText" Foreground="{DynamicResource PrimaryText}" />
            <TextBlock Classes="caption" Text="on WindowBackground" />
          </StackPanel>
        </Border>
        <Border Classes="card" Margin="0,0,12,12">
          <StackPanel Spacing="4">
            <TextBlock Text="Foreground" Foreground="{DynamicResource Foreground}" />
            <TextBlock Text="MutedForeground" Foreground="{DynamicResource MutedForeground}" />
            <TextBlock Text="SubtleForeground" Foreground="{DynamicResource SubtleForeground}" />
            <TextBlock Text="PrimaryText" Foreground="{DynamicResource PrimaryText}" />
            <TextBlock Classes="caption" Text="on CardBackground" />
          </StackPanel>
        </Border>
        <Border Classes="card" Background="{DynamicResource InputBackground}" Margin="0,0,12,12">
          <StackPanel Spacing="4">
            <TextBlock Text="Foreground" Foreground="{DynamicResource Foreground}" />
            <TextBlock Text="MutedForeground" Foreground="{DynamicResource MutedForeground}" />
            <TextBlock Text="SubtleForeground" Foreground="{DynamicResource SubtleForeground}" />
            <TextBlock Text="PrimaryText" Foreground="{DynamicResource PrimaryText}" />
            <TextBlock Classes="caption" Text="on InputBackground" />
          </StackPanel>
        </Border>
      </WrapPanel>

      <TextBlock Classes="heading" Text="Accent" />
      <WrapPanel Orientation="Horizontal">
        <StackPanel Margin="0,0,12,12">
          <Border Classes="swatch" Background="{DynamicResource Primary}">
            <TextBlock Text="On accent"
                       Foreground="{DynamicResource OnPrimaryForeground}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Classes="caption" Text="Primary + OnPrimaryForeground" />
        </StackPanel>
        <StackPanel Margin="0,0,12,12">
          <Border Classes="swatch" Background="{DynamicResource PrimaryHover}" />
          <TextBlock Classes="caption" Text="PrimaryHover" />
        </StackPanel>
        <StackPanel Margin="0,0,12,12">
          <Border Classes="swatch" Background="{DynamicResource PrimaryPressed}" />
          <TextBlock Classes="caption" Text="PrimaryPressed" />
        </StackPanel>
        <StackPanel Margin="0,0,12,12">
          <Border Classes="swatch"
                  Background="{DynamicResource WindowBackground}"
                  BorderBrush="{DynamicResource FocusRing}"
                  BorderThickness="2">
            <TextBlock Text="Focus ring"
                       Foreground="{DynamicResource PrimaryText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Classes="caption" Text="FocusRing + PrimaryText" />
        </StackPanel>
      </WrapPanel>

      <TextBlock Classes="heading" Text="Status" />
      <WrapPanel Orientation="Horizontal">
        <Border Margin="0,0,12,12" Padding="14"
                CornerRadius="{DynamicResource RadiusMd}"
                Background="{DynamicResource DangerBackground}"
                BorderBrush="{DynamicResource Danger}" BorderThickness="1">
          <TextBlock Text="Danger message" Foreground="{DynamicResource DangerText}" />
        </Border>
        <Border Margin="0,0,12,12" Padding="14"
                CornerRadius="{DynamicResource RadiusMd}"
                Background="{DynamicResource WarningBackground}"
                BorderBrush="{DynamicResource Warning}" BorderThickness="1">
          <TextBlock Text="Warning message" Foreground="{DynamicResource WarningText}" />
        </Border>
        <Border Margin="0,0,12,12" Padding="14"
                CornerRadius="{DynamicResource RadiusMd}"
                Background="{DynamicResource SuccessBackground}"
                BorderBrush="{DynamicResource Success}" BorderThickness="1">
          <TextBlock Text="Success message" Foreground="{DynamicResource SuccessText}" />
        </Border>
      </WrapPanel>

      <TextBlock Classes="heading" Text="Typography and metrics" />
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="Inter is embedded, not resolved by family name."
                     Foreground="{DynamicResource Foreground}"
                     FontFamily="{DynamicResource FontFamilyDefault}" />
          <TextBlock Text="0123456789  save.dat  0x1F4A9"
                     Foreground="{DynamicResource MutedForeground}"
                     FontFamily="{DynamicResource FontFamilyMono}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Width="24" Height="24" Background="{DynamicResource Primary}"
                    CornerRadius="{DynamicResource RadiusSm}" />
            <Border Width="24" Height="24" Background="{DynamicResource Primary}"
                    CornerRadius="{DynamicResource RadiusMd}" />
            <Border Width="24" Height="24" Background="{DynamicResource Primary}"
                    CornerRadius="{DynamicResource RadiusLg}" />
            <TextBlock Classes="caption" Text="RadiusSm / RadiusMd / RadiusLg" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
