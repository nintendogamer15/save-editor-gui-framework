<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SaveEditor.Ui.Gallery.Views"
        x:Class="SaveEditor.Ui.Gallery.MainWindow"
        Title="Save Editor UI Gallery"
        Width="1200" Height="900"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{DynamicResource FontFamilyDefault}">

  <DockPanel>

    <Border DockPanel.Dock="Top"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="0,0,0,1"
            Padding="16,10">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="Appearance"
                   Foreground="{DynamicResource Foreground}"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />

        <ComboBox x:Name="ThemeSelector" Width="120" VerticalAlignment="Center" />

        <TextBlock Text="Accent"
                   Foreground="{DynamicResource MutedForeground}"
                   VerticalAlignment="Center" />

        <ComboBox x:Name="AccentSelector" Width="150" VerticalAlignment="Center" />

        <Button x:Name="ResetAccent"
                Content="Reset to editor default"
                VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <views:TokenGalleryView />

  </DockPanel>

</Window>
