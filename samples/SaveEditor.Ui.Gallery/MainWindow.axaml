<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:SaveEditor.Ui.Shell;assembly=SaveEditor.Ui"
        x:Class="SaveEditor.Ui.Gallery.MainWindow"
        Title="Save Editor UI Gallery"
        Width="1280" Height="900"
        Background="{DynamicResource WindowBackground}">

  <!--
    The gallery is the framework shell, hosting the catalogue pages as sections.
    Showing the shell by being the shell keeps the catalogue honest: anything
    broken in the shell is broken in the gallery too.
  -->
  <shell:EditorShell x:Name="Shell">

    <shell:EditorShell.Branding>
      <StackPanel>
        <TextBlock Text="SaveEditor.Ui"
                   Foreground="{DynamicResource Foreground}"
                   FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="Control gallery"
                   Foreground="{DynamicResource SubtleForeground}"
                   FontSize="11" />
      </StackPanel>
    </shell:EditorShell.Branding>

    <shell:EditorShell.HeaderActions>
      <Button x:Name="SimulateEdit"
              Content="Simulate an edit"
              AutomationProperties.Name="Simulate an edit" />
    </shell:EditorShell.HeaderActions>

    <shell:EditorShell.StatusBarExtension>
      <TextBlock Text="No file I/O is performed by the gallery."
                 Foreground="{DynamicResource SubtleForeground}"
                 FontSize="11"
                 VerticalAlignment="Center" />
    </shell:EditorShell.StatusBarExtension>

  </shell:EditorShell>

</Window>
