<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theming="clr-namespace:SaveEditor.Ui.Theming;assembly=SaveEditor.Ui"
             x:Class="SaveEditor.Generated.App"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <!-- A base Avalonia theme first, then the framework's — see README.md. -->
    <FluentTheme />
    <theming:SaveEditorTheme />
  </Application.Styles>

</Application>
