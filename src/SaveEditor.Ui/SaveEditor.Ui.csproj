<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>SaveEditor.Ui</PackageId>
    <Title>Save Editor GUI Framework</Title>
    <Description>Reusable Avalonia shell, themed controls, and safe file workflow for building game save editors.</Description>
    <PackageTags>avalonia;save-editor;gui;framework</PackageTags>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

</Project>
