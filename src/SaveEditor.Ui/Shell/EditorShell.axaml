<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:SaveEditor.Ui.Shell"
             x:Class="SaveEditor.Ui.Shell.EditorShell"
             x:DataType="shell:EditorShellViewModel"
             x:Name="Root"
             Background="{DynamicResource WindowBackground}"
             FontFamily="{DynamicResource FontFamilyDefault}">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenSaveCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="Ctrl+R" Command="{Binding ReloadCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
  </UserControl.KeyBindings>

  <DockPanel>

    <!-- Menus are always in-window, on every platform. -->
    <Menu DockPanel.Dock="Top"
          Background="{DynamicResource PanelBackground}"
          Padding="6,2">

      <MenuItem Header="_File">
        <MenuItem Header="_Open Save…" Command="{Binding OpenSaveCommand}" InputGesture="Ctrl+O" />
        <!--
          Command lives on the row. Submenu items are realized into a popup,
          which is a separate visual tree, so $parent cannot reach EditorShell.
          BasedOn keeps the default MenuItem template; without it the containers
          render empty.
        -->
        <MenuItem Header="_Recent" ItemsSource="{Binding RecentMenuOptions}">
          <MenuItem.ItemContainerTheme>
            <ControlTheme TargetType="MenuItem"
                          BasedOn="{StaticResource {x:Type MenuItem}}"
                          x:DataType="shell:ShellMenuOption">
              <Setter Property="Header" Value="{Binding Header}" />
              <Setter Property="ToolTip.Tip" Value="{Binding Tip}" />
              <Setter Property="AutomationProperties.HelpText" Value="{Binding Tip}" />
              <Setter Property="Command" Value="{Binding Command}" />
              <Setter Property="CommandParameter" Value="{Binding Parameter}" />
            </ControlTheme>
          </MenuItem.ItemContainerTheme>
        </MenuItem>
        <Separator />
        <MenuItem Header="Save _As…" Command="{Binding SaveAsCommand}" InputGesture="Ctrl+S" />
        <MenuItem Header="Over_write + Backup…" Command="{Binding OverwriteWithBackupCommand}" />
        <Separator />
        <MenuItem Header="Re_load" Command="{Binding ReloadCommand}" InputGesture="Ctrl+R" />
        <MenuItem Header="_Close" Command="{Binding CloseCommand}" InputGesture="Ctrl+W" />
        <Separator />
        <MenuItem Header="E_xit"
                  Command="{Binding ExitCommand}"
                  IsVisible="{Binding CanExit}" />
      </MenuItem>

      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z" />
        <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y" />
      </MenuItem>

      <MenuItem Header="_View">
        <MenuItem Header="_Appearance" IsVisible="{Binding CanChangeAppearance}">
          <MenuItem Header="_Themes" ItemsSource="{Binding ThemeMenuOptions}">
            <MenuItem.ItemContainerTheme>
              <ControlTheme TargetType="MenuItem"
                            BasedOn="{StaticResource {x:Type MenuItem}}"
                            x:DataType="shell:ShellMenuOption">
                <Setter Property="Header" Value="{Binding Header}" />
                <Setter Property="Command" Value="{Binding Command}" />
                <Setter Property="CommandParameter" Value="{Binding Parameter}" />
              </ControlTheme>
            </MenuItem.ItemContainerTheme>
          </MenuItem>
          <MenuItem Header="A_ccent" ItemsSource="{Binding AccentMenuOptions}">
            <MenuItem.ItemContainerTheme>
              <ControlTheme TargetType="MenuItem"
                            BasedOn="{StaticResource {x:Type MenuItem}}"
                            x:DataType="shell:ShellMenuOption">
                <Setter Property="Header" Value="{Binding Header}" />
                <Setter Property="Command" Value="{Binding Command}" />
                <Setter Property="CommandParameter" Value="{Binding Parameter}" />
              </ControlTheme>
            </MenuItem.ItemContainerTheme>
          </MenuItem>
          <Separator />
          <MenuItem Header="_Reset accent to editor default" Command="{Binding ResetAccentCommand}" />
        </MenuItem>
      </MenuItem>

      <MenuItem Header="_Help">
        <MenuItem Header="_About and credits" Command="{Binding ShowAboutCommand}" />
        <MenuItem Header="_Safety and manual testing" Command="{Binding ShowSafetyCommand}" />
      </MenuItem>

      <!--
        A ContentControl is a menu-bar item even when empty. MenuExtensions is
        optional, so the slot has to collapse rather than draw a blank entry
        after Help.
      -->
      <ContentControl Content="{Binding MenuExtensions, ElementName=Root}"
                      IsVisible="{Binding MenuExtensions, ElementName=Root, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </Menu>

    <!-- Status bar is the canonical outcome channel. -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="0,1,0,0"
            Padding="12,6">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
        <TextBlock Grid.Column="0"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource Foreground}"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="Status" />

        <!-- Progress, so a slow save is distinguishable from a hung one. -->
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsBusy}">
          <TextBlock Text="{Binding ProgressDescription}"
                     Foreground="{DynamicResource MutedForeground}"
                     VerticalAlignment="Center"
                     AutomationProperties.LiveSetting="Polite"
                     AutomationProperties.Name="Progress" />
          <ProgressBar Width="120"
                       Height="4"
                       Minimum="0"
                       Maximum="1"
                       Value="{Binding ProgressFraction}"
                       IsIndeterminate="{Binding ProgressFraction, Converter={x:Static ObjectConverters.IsNull}}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- Where the last backup went. "A backup was written" is only useful with it. -->
        <TextBlock Grid.Column="2"
                   Text="{Binding LastBackupLabel.Label}"
                   ToolTip.Tip="{Binding LastBackupLabel.FullLabel}"
                   AutomationProperties.HelpText="{Binding LastBackupLabel.FullLabel}"
                   AutomationProperties.Name="Last backup"
                   Foreground="{DynamicResource SubtleForeground}"
                   Margin="12,0,0,0"
                   ClipToBounds="True"
                   VerticalAlignment="Center"
                   IsVisible="{Binding LastBackupLabel, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <ContentControl Grid.Column="3"
                        Content="{Binding StatusBarExtension, ElementName=Root}"
                        Margin="12,0,0,0"
                        IsVisible="{Binding StatusBarExtension, ElementName=Root, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Grid.Column="4"
                   Text="{Binding CurrentPathLabel.Label}"
                   ToolTip.Tip="{Binding CurrentPathLabel.FullLabel}"
                   AutomationProperties.HelpText="{Binding CurrentPathLabel.FullLabel}"
                   AutomationProperties.Name="Current save"
                   Foreground="{DynamicResource MutedForeground}"
                   Margin="12,0,0,0"
                   ClipToBounds="True"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Header actions: the framework's four, then the editor's. -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="0,0,0,1"
            Padding="12,8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Open Save"
                Classes="accent"
                Command="{Binding OpenSaveCommand}"
                AutomationProperties.Name="Open Save" />
        <Button Content="Save As"
                Command="{Binding SaveAsCommand}"
                AutomationProperties.Name="Save As" />
        <Button Content="Undo"
                Command="{Binding UndoCommand}"
                AutomationProperties.Name="Undo" />
        <Button Content="Redo"
                Command="{Binding RedoCommand}"
                AutomationProperties.Name="Redo" />
        <ContentControl Content="{Binding HeaderActions, ElementName=Root}"
                        IsVisible="{Binding HeaderActions, ElementName=Root, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </Border>

    <!-- Sidebar: framework navigation, then editor content. -->
    <Border DockPanel.Dock="Left"
            Width="248"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="0,0,1,0">
      <DockPanel>
        <ContentControl DockPanel.Dock="Top"
                        Content="{Binding Branding, ElementName=Root}"
                        Margin="14,14,14,8" />

        <ContentControl DockPanel.Dock="Bottom"
                        Content="{Binding SidebarExtension, ElementName=Root}"
                        Margin="14,8,14,14"
                        IsVisible="{Binding SidebarExtension, ElementName=Root, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <ListBox ItemsSource="{Binding Sections}"
                 SelectedItem="{Binding SelectedSection}"
                 Background="Transparent"
                 BorderThickness="0"
                 Margin="6"
                 AutomationProperties.Name="Sections">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="shell:SectionDescriptor">
              <Grid ColumnDefinitions="Auto,*" Margin="6,4">
                <!-- The descriptor accepts an Icon, so the shell has to show one.
                     A property that is read and never rendered is indistinguishable
                     from a broken one. -->
                <ContentControl Grid.Column="0"
                                Content="{Binding Icon}"
                                IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Foreground}" />
                  <TextBlock Text="{Binding Subtitle}"
                             Foreground="{DynamicResource SubtleForeground}"
                             FontSize="11"
                             IsVisible="{Binding Subtitle, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Content: welcome state until a document is open. -->
    <Panel>
      <!--
        Section bodies own their own scrolling. Wrapping them here measured the body
        against an unconstrained height, which starves a virtualizing FieldList of a
        viewport so it realizes nothing at all, and double-nested scroll areas for
        every body that already scrolls.
      -->
      <ContentControl IsVisible="{Binding !IsWelcomeVisible}"
                      Content="{Binding SelectedSection.Body}"
                      Margin="20" />

      <StackPanel IsVisible="{Binding IsWelcomeVisible}"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  MaxWidth="420"
                  Spacing="10">
        <TextBlock Text="No save open"
                   Foreground="{DynamicResource Foreground}"
                   FontSize="22"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Open a save file to begin editing."
                   Foreground="{DynamicResource MutedForeground}"
                   HorizontalAlignment="Center" />
        <Button Content="Open Save…"
                Classes="accent"
                Command="{Binding OpenSaveCommand}"
                HorizontalAlignment="Center"
                Margin="0,6,0,10" />

        <TextBlock Text="Recent"
                   Foreground="{DynamicResource MutedForeground}"
                   FontSize="12"
                   IsVisible="{Binding Recents.Count}" />
        <ItemsControl ItemsSource="{Binding Recents}"
                      AutomationProperties.Name="Recent files">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="shell:RecentEntry">
              <Button Content="{Binding Label.Label}"
                      ToolTip.Tip="{Binding Label.FullLabel}"
                      AutomationProperties.HelpText="{Binding Label.FullLabel}"
                      Command="{Binding $parent[shell:EditorShell].DataContext.OpenRecentCommand}"
                      CommandParameter="{Binding}"
                      Background="Transparent"
                      BorderThickness="0"
                      HorizontalContentAlignment="Left"
                      Foreground="{DynamicResource PrimaryText}"
                      Margin="0,1" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Panel>

  </DockPanel>

</UserControl>
