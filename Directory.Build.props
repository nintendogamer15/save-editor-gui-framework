<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!--
      TreatWarningsAsErrors covers the C# compiler only. Avalonia's XAML
      diagnostics (AVLN*) and NuGet's (NU*) are emitted by MSBuild tasks and
      slip past it, which is how an obsolete-API warning sat in a XAML file
      while the build reported success.
    -->
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <!--
      A bare Version="12.1.1" is a lower bound, not a pin: NuGet reads it as "at
      least", and it would float if that exact version were ever unlisted. The lock
      file is what actually makes restore reproducible, and CI restores in locked
      mode so a drifting graph fails the build instead of resolving quietly.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <PropertyGroup Label="Identity">
    <Product>Save Editor GUI Framework</Product>
    <Authors>nintendogamer15</Authors>
    <Copyright>Copyright (c) 2026 nintendogamer15</Copyright>
    <RepositoryUrl>https://github.com/nintendogamer15/save-editor-gui-framework</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>alpha.1</VersionSuffix>
  </PropertyGroup>

</Project>
