<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Versions are pinned by PLAN.md section 3. Avalonia is major version 12, not 11:
    control-theme and headless-testing APIs differ materially between them.

    Tests run on Microsoft.Testing.Platform (xunit.v3 native), not VSTest, so
    neither Microsoft.NET.Test.Sdk nor xunit.runner.visualstudio is referenced.
    Avalonia.Headless.XUnit 12.1.1 depends on xunit.v3.extensibility.core 3.2.2,
    so the Avalonia and xunit pins must move together.
  -->
  <ItemGroup Label="Avalonia">
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup Label="Framework">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

</Project>
